APP_NAME="BK Presensi SMK IPTEK SANGGABUANA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bk_presensi_smk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smkipteksanggabuana.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CONTACT_BK=
TELEGRAM_CONTACT_ADMIN=

# Upload limits
MAX_FILE_SIZE_KB=5120
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Attendance config
ATTENDANCE_LOCK_HOUR=16
ATTENDANCE_TIMEZONE=Asia/Jakarta
ATTENDANCE_AUTO_ALPA_ENABLED=false
ATTENDANCE_AUTO_ALPA_HOUR=17

# Bot service token (for internal API auth from telegram bot)
BOT_SERVICE_TOKEN=your-bot-service-token-here
